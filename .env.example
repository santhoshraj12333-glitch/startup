# ============================================================
# AI Urban Intelligence Platform – Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git – it is already in .gitignore.
# ============================================================

# ------ Apify (YouTube & Instagram scraping) ---------------
# Get your token from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Daily safety caps (FreeTierProtector) ---------------------
APIFY_DAILY_LIMIT=5          # max Apify actor runs per day (protects $5/mo free credit)
YOUTUBE_DAILY_LIMIT=20       # max YouTube Data API searches per day (10k unit pool)
X_DAILY_LIMIT=3              # max X API requests per day

# ------ YouTube Data API v3 (optional) ---------------------
# Get your key from: https://console.cloud.google.com → APIs → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# ------ X (Twitter) API Bearer Token (optional) ------------
# Get from: https://developer.twitter.com/en/portal/dashboard
X_BEARER_TOKEN=your_x_bearer_token_here

# ------ Person 2 NLP Integration ---------------------------
# URL of Person 2's NLP processing endpoint
PERSON2_NLP_URL=http://localhost:8001/process
# Shared API key for authenticating requests to Person 2
PERSON2_API_KEY=your_shared_api_key_here

# ------ Google Play Store (optional) -----------------------
# App ID to scrape reviews from (the part after id= in Play Store URL)
# Example: com.mochilabs.chennaiOne
PLAYSTORE_APP_ID=com.mochilabs.chennaiOne

# ------ Backend Config -------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ------ Override quota guard (use with caution!) -----------
# Set to 1 to bypass free-tier daily caps (risk of credit exhaustion)
BYPASS_QUOTA_GUARD=0

